{
  "name": "automotive-insights-hub-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "python run_all.py",
    "dev:all": "python run_all.py",
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "python backend/manage.py runserver 0.0.0.0:8000",
    "build": "npm --prefix frontend run build",
    "build:dev": "npm --prefix frontend run build:dev",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "format": "npm --prefix frontend run format",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build"
  }
}
